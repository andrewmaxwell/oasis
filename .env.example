# Copy to .env and fill in from the Supabase dashboard (Project Settings → API).
# Both values are baked into the client bundle at build time and are public by design.
VITE_SUPABASE_URL=your_supabase_url
# Anon/public key ONLY — never the service role key, which would ship to every browser.
VITE_SUPABASE_KEY=your_supabase_anon_key
