# Loaded by `vite --mode e2e`, which the Playwright suite starts the dev server with.
# Mode-specific env files outrank `.env`, so a developer's real project credentials cannot
# leak into an E2E run — the suite mocks this host, and any request that escapes the mock
# fails the test rather than reaching a real database.
VITE_SUPABASE_URL=https://oasis-e2e.supabase.co
VITE_SUPABASE_KEY=e2e-anon-key
